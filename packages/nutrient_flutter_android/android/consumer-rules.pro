# Keep rules applied to apps that use nutrient_flutter_android when they build with R8 (Flutter release
# builds shrink by default). Keep only what is reached by name rather than by a normal Java/Kotlin reference.

# Dart calls these through JNI by name, so R8 can't see that they're used.
-keep class com.nutrient.nutrient_flutter_android.AnnotationProviderBlocking {
    public static *;
}
-keep class com.nutrient.nutrient_flutter_android.FormProviderBlocking {
    public static *;
}

# Called from Dart over JNI by name (jnigen bindings, lib/src/bindings/nutrient_android_sdk_bindings.dart).
# Keep this in sync with the plugin classes listed in jnigen.yaml.
-keep class com.nutrient.nutrient_flutter_android.FragmentContainerPlatformView { *; }
-keep class com.nutrient.nutrient_flutter_android.FragmentContainerPlatformView$Companion { *; }

# NutrientView passes this class to PdfUiFragmentBuilder.fragmentClass() after a
# JClass.forName lookup, and the SDK instantiates it through its no-arg constructor.
-keep class com.nutrient.nutrient_flutter_android.NutrientPdfUiFragment {
    public <init>();
}

# The Nutrient SDK checks the app really is a Flutter app with Class.forName on a
# fixed list of names (HybridLicenseHelper). This plugin's classes aren't on it and
# R8 strips the unreferenced io.flutter.BuildConfig, so without this rule release
# builds fail Nutrient.initialize with "unusual setup for your Flutter project".
-keep class io.flutter.BuildConfig

# The JNI bindings look up Nutrient Android SDK methods by name and JNI signature, and
# those signatures name the AndroidX, Kotlin, Flutter and other library classes below.
# If R8 renames one, every SDK method that takes or returns it fails with
# NoSuchMethodError (for example FragmentContainerPlatformView.attachFragment(int,
# Fragment)). The block below lists the classes
# lib/src/bindings/nutrient_android_sdk_bindings.dart names that aren't framework, SDK
# or plugin classes. scripts/update_keep_rules.dart writes it, generate_bindings.sh runs
# that after every regeneration, and CI fails if it's out of date. Keep hand-written
# rules outside it.
# BEGIN GENERATED by scripts/update_keep_rules.dart. Do not edit by hand.
